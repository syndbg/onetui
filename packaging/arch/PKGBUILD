# Source build from the release tag: links Arch's own cyrus-sasl, krb5 and curl.
# Keep pkgver equal to the Cargo version. `make release-check` enforces it.
pkgname=onetui
pkgver=0.2.0
pkgrel=1
pkgdesc='A terminal browser for databases and streams'
arch=(x86_64)
url='https://github.com/syndbg/onetui'
license=(Apache-2.0)
depends=(curl cyrus-sasl krb5 gcc-libs glibc)
makedepends=(cargo cmake git perl)
source=("git+$url.git#tag=v$pkgver")
sha256sums=(SKIP)

build() {
  cd onetui
  cargo build --release --locked
}

package() {
  cd onetui
  install -Dm755 target/release/onetui "$pkgdir/usr/bin/onetui"
  install -Dm644 LICENSE THIRD_PARTY_NOTICES.md -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
}
