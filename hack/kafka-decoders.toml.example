# Copy the desired binding into your onetui.toml.
# Replace schema_file with an absolute local path. Paths are not shell-expanded.
[connections.local_kafka]
kind = "kafka"
bootstrap_servers = ["127.0.0.1:19092"]
security_protocol = "PLAINTEXT"

[[connections.local_kafka.decoders]]
topic = "events"
field = "value"
format = "avro"
framing = "raw"
schema_file = "/absolute/path/to/event.avsc"

[[connections.local_kafka.decoders]]
topic = "orders"
field = "key"
format = "protobuf"
framing = "raw"
schema_file = "/absolute/path/to/event.pb"
message_name = "demo.Event"

# Custom endpoint example. For the seeded local registry, use local_redpanda
# from hack/connections.toml after make dev-up.
# Keep only bindings for topics you use. This endpoint is a placeholder.
[[connections.local_kafka.decoders]]
topic = "registered_events"
field = "value"
format = "avro"
framing = "confluent"
[connections.local_kafka.decoders.registry]
url = "https://registry.example.com"
# Optional HTTP Basic authentication; omit both for anonymous access.
# username_env = "REGISTRY_USER"
# password_env = "REGISTRY_PASSWORD"
# Or use token_env = "REGISTRY_TOKEN" instead of Basic authentication.
# ca_file = "/absolute/path/to/registry-ca.pem"
