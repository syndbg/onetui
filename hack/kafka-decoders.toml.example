# Copy the desired binding into your onetui.toml.
# Replace schema_file with an absolute local path. Paths are not shell-expanded.
[connections.local_kafka]
kind = "kafka"
bootstrap_servers = ["127.0.0.1:19092"]
security_protocol = "PLAINTEXT"

[[connections.local_kafka.decoders]]
topic = "events"
field = "value"
format = "avro"
framing = "raw"
schema_file = "/absolute/path/to/event.avsc"

[[connections.local_kafka.decoders]]
topic = "orders"
field = "key"
format = "protobuf"
framing = "raw"
schema_file = "/absolute/path/to/event.pb"
message_name = "demo.Event"
