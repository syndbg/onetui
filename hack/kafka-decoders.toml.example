# Copy the desired binding into your onetui.toml.
# Replace schema_file with an absolute local path. Paths are not shell-expanded.
# Directory bindings below use filename stems; reopen the connection after edits.
[connections.local_kafka]
kind = "kafka"
bootstrap_servers = ["127.0.0.1:19092"]
security_protocol = "PLAINTEXT"

[[connections.local_kafka.decoders]]
topic = "events"
field = "value"
format = "avro"
framing = "raw"
schema_file = "/absolute/path/to/event.avsc"
# Optional Avro reader projection; omit to display writer values.
# reader_schema_file = "/absolute/path/to/event-reader.avsc"

[[connections.local_kafka.decoders]]
topic = "orders"
field = "key"
format = "protobuf"
framing = "raw"
schema_file = "/absolute/path/to/event.pb"
message_name = "demo.Event"

[[connections.local_kafka.decoders]]
topic = "catalog_avro"
field = "value"
format = "avro"
framing = "raw"
catalog = { directory = "/absolute/schemas", schema = "event", references = ["customer"] }

[[connections.local_kafka.decoders]]
topic = "catalog_protobuf"
field = "key"
format = "protobuf"
framing = "raw"
message_name = "demo.Event"
catalog = { directory = "/absolute/schemas", schema = "event_proto" }

# Replace module, commit and message with your published Protobuf schema.
[[connections.local_kafka.decoders]]
topic = "buf_events"
field = "value"
format = "protobuf"
framing = "raw"
message_name = "demo.Event"
[connections.local_kafka.decoders.buf]
url = "https://buf.build"
module = "your-org/your-module"
revision = "0123456789abcdef0123456789abcdef"
# Or replace revision with label = "main"; reconnect to resolve it again.
# token_env = "BUF_TOKEN"
# ca_file = "/absolute/path/to/buf-ca.pem"

# Custom endpoint example. For the seeded local registry, use local_redpanda
# from target/demo-onetui.toml after make dev-up.
# Keep only bindings for topics you use. This endpoint is a placeholder.
[[connections.local_kafka.decoders]]
topic = "registered_events"
field = "value"
format = "avro"
framing = "confluent"
[connections.local_kafka.decoders.registry]
url = "https://registry.example.com"
# Optional HTTP Basic authentication; omit both for anonymous access.
# username_env = "REGISTRY_USER"
# password_env = "REGISTRY_PASSWORD"
# Or use token_env = "REGISTRY_TOKEN" instead of Basic authentication.
# ca_file = "/absolute/path/to/registry-ca.pem"

[[connections.local_kafka.decoders]]
topic = "registered_protobuf_events"
field = "value"
format = "protobuf"
framing = "confluent"
# The envelope selects the message; no schema_file or message_name.
[connections.local_kafka.decoders.registry]
url = "https://registry.example.com"
